# =====================================================================
# Krishi Khoj Environment Configuration Template
# Copy this file to .env and configure your local settings.
# Do NOT commit your actual .env file to version control.
# =====================================================================

# Flask Secret Key for signed session cookies
# Generate a secure key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-key

# Deployment Environment: 'development' or 'production'
FLASK_ENV=development

# Cookie Security (set to True when deploying behind HTTPS)
SESSION_COOKIE_SECURE=False
